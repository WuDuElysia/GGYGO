# ============================================================
# Unreal Engine 生成物（工程根与所有插件内同名目录均忽略）
# ============================================================
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/

# UE 自动生成的解决方案与工程文件
*.sln
*.slnx
*.suo
*.sdf
*.opensdf
*.opendb
*.VC.db
*.VC.opendb
*.xcodeproj/
*.xcworkspace/

# ============================================================
# IDE / 编辑器
# ============================================================
.vs/
.idea/
.vscode/

# Rider 等 IDE 自动安装/更新的集成插件（RiderLink），属于本地开发环境产物。
/Plugins/Developer/

# ============================================================
# 操作系统
# ============================================================
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store

# ============================================================
# 参考资料副本
# ============================================================
# Lyra 的不完整局部副本。完整参考工程在 F:\ue_project\LyraStarterGame，不纳入本仓库。
/Lyra/

# ZZZ 资产解包导出目录，约 117 GB / 60 万文件，属于外部原始资产，不纳入本仓库。
/Exports/

# ZZZ 逆向导出的二进制数据（单文件百 MB 级）。
/Maps/

# Python 缓存（AAADocs/Scripts 下的分析脚本会产生）
__pycache__/
*.pyc

# ============================================================
# Content：美术资产整体约 15 GB，不进普通 git
# ============================================================
# 默认忽略 Content 下全部内容，再逐个白名单放行体积可控的自研资产。
# 被排除的大体积目录（Characters、Player、FoggyStreet、Resourse、Model 等）
# 需要走外部资产管线（Perforce / LFS / 网盘）单独管理。
/Content/*
!/Content/Anim/
!/Content/BP/
!/Content/Input/
!/Content/Map/
!/Content/Collections/
